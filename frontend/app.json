{
  "expo": {
    "name": "frontend",
    "slug": "frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/neia-icon.png",
    "scheme": "frontend",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.emergent.neiasalgadosapp.yodpjg",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Enviar sua posição durante entregas",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Enviar sua posição durante entregas",
        "NSPhotoLibraryUsageDescription": "Selecionar fotos dos salgados",
        "NSCameraUsageDescription": "Tirar fotos dos salgados"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/neia-adaptive.png",
        "backgroundColor": "#F4B821"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.emergent.neiasalgadosapp.yodpjg",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "CAMERA",
        "READ_MEDIA_IMAGES"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/neia-favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/neia-splash.png",
          "imageWidth": 260,
          "resizeMode": "contain",
          "backgroundColor": "#F4B821"
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Compartilhar sua localização com clientes durante entregas"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Selecionar fotos dos salgados",
          "cameraPermission": "Tirar fotos dos salgados"
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
